params {
    outdir = "./results"
}

conda {
    enabled = true
}

process {
    withName: '.*FASTQC.*' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    withName: '.*MULTIQC.*' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }

    withName: '.*SINGLEM_PIPE.*' {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
}